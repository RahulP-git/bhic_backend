PORT=5000
MONGODB_URI=mongodb+srv://db_username:db_password@cluster0.example.mongodb.net/bhic
MONGODB_DB_NAME=bhic
NODE_ENV=development
AUTH_DEBUG_OTP=true
DEBUG_OTP=123456
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=31536000000
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/5 * * * *
FCM_ENABLED=false
FCM_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
